{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    // examples は動作確認用アプリなので、ライブラリとしての型定義出力は不要
    "declaration": false,
    "strict": true,
    "importHelpers": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "stripInternal": true,
    "skipLibCheck": true,
    "newLine": "LF",
    "types": ["dom-mediacapture-transform"],
    "lib": ["ES2022", "dom"]
  },
  "exclude": ["node_modules"]
}
