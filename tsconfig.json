{
  "compilerOptions": {
    // 出力ターゲット
    "target": "ES2022",
    "module": "ES2022",

    // strict ファミリー一括有効化
    "strict": true,
    // null/undefined を厳密に扱う
    "strictNullChecks": true,
    // オプショナルプロパティと undefined を区別する
    "exactOptionalPropertyTypes": true,
    // インデックスアクセスの結果に undefined を含める
    "noUncheckedIndexedAccess": true,
    // インデックスシグネチャ越しのアクセスにはブラケット記法を強制する
    "noPropertyAccessFromIndexSignature": true,
    // override キーワードの付け忘れを検出する
    "noImplicitOverride": true,

    // 型定義ファイルを出力する
    "declaration": true,
    // @internal タグ付き宣言を .d.ts から除外する
    "stripInternal": true,

    // ヘルパーを tslib から import する
    "importHelpers": true,

    // モジュール解決方式
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    // type-only import / export を厳密に区別する
    "verbatimModuleSyntax": true,
    // 各ファイルを単独でトランスパイル可能にする
    "isolatedModules": true,
    // ファイル名の大文字小文字の不一致を検出する
    "forceConsistentCasingInFileNames": true,
    // クラスフィールドの挙動を ES2022 に合わせる
    "useDefineForClassFields": true,

    // 未使用検出
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // すべてのコードパスが値を返すことを強制する
    "noImplicitReturns": true,
    // switch 文のフォールスルーを禁止する
    "noFallthroughCasesInSwitch": true,

    // 改行コードを LF に統一
    "newLine": "LF",

    // 組み込みで利用する型定義
    "types": ["dom-mediacapture-transform"],
    "lib": ["ES2022", "dom"],

    // 出力先
    "outDir": "dist",

    // DOM 関連型定義の競合を回避する
    "skipLibCheck": true,

    // 実験的デコレーターを有効化
    "experimentalDecorators": true,

    // 型エラーメッセージを省略させない
    "noErrorTruncation": true
  }
}
